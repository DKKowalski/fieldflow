                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Run this folder first. Registration creates a technician. The two login requests save the corresponding access tokens.",
      "item": [
        {
          "name": "Register technician",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{technicianEmail}}\",\n  \"displayName\": \"Postman Technician\",\n  \"password\": \"{{technicianPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a technician account. A 409 response is acceptable when the same collection data was used before."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('creates the technician or reports that it exists', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('technicianId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login technician",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{technicianEmail}}\",\n  \"password\": \"{{technicianPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('technicianToken', body.accessToken);",
                  "  pm.collectionVariables.set('technicianId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login dispatcher",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{dispatcherEmail}}\",\n  \"password\": \"{{dispatcherPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Set dispatcherEmail and dispatcherPassword in the collection variables before sending this request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('dispatcherToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get dispatcher profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/profile"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns the dispatcher token payload', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().role).to.eql('dispatcher');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
