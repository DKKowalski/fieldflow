{
  "info": {
    "_postman_id": "99186906-6f9b-4e71-af80-72db307b31bb",
    "name": "FieldFlow API",
    "description": "Requests for every route currently registered by the FieldFlow API. Run the folders in order. Before running them, set dispatcherEmail and dispatcherPassword in the collection Variables tab. Registration creates technicians only, so the dispatcher account must already exist with the dispatcher role. Login and create requests save tokens and resource IDs for later requests. UserController routes are not included because UserController is not registered in UserModule.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{dispatcherToken}}",
        "type": "string"
      }
    ]
  },
