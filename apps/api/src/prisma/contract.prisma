// use prisma-next
enum WorkOrderStatus {
  @@type("pg/text@1")

  open = "open"
  in_progress = "in_progress"
  completed = "completed"
  cancelled = "cancelled"
}


enum UserRole {
  @@type("pg/text@1")

  dispatcher = "dispatcher"
  technician = "technician"
}

model WorkOrder {
  id           Uuid                       @id @default(uuid())
  title        VarChar(120)
  
  status       WorkOrderStatus            @default(open)
  createdAt    TimestamptzString          @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")

  assignedTechnicianId Uuid? @map("assigned_technician_id")
  serviceLocationId     Uuid  @map("service_location_id")

  assignedTechnician User? @relation(
    fields: [assignedTechnicianId],
    references: [id],
    onDelete: SetNull,
    onUpdate: Cascade
  )


  serviceLocation ServiceLocation @relation(
    fields: [serviceLocationId],
    references: [id],
    onDelete: Restrict,
    onUpdate: Cascade
  )

  @@index([assignedTechnicianId])

  @@index([serviceLocationId])

  @@map("work_orders")
}


model User{
  id       Uuid              @id @default(uuid())
  displayName VarChar(120)      @map("display_name")
  email     VarChar(255)      @unique
  passwordHash  VarChar(255)  @map("password_hash")
  role     UserRole           @default(technician)
  createdAt TimestamptzString @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  @@map("users")
}


model Customer {
  id        Uuid                       @id @default(uuid())
  name      VarChar(120)
  phone     VarChar(30)
  email     VarChar(255)?
  createdAt TimestamptzString          @default(now()) @map("created_at")
  updatedAt temporal.updatedAtString() @map("updated_at")

  @@map("customers")
}

model ServiceLocation {
  id           Uuid                       @id @default(uuid())
  customerId   Uuid                       @map("customer_id")
  label        VarChar(80)
  addressLine1 VarChar(160)               @map("address_line_1")
  addressLine2 VarChar(160)?              @map("address_line_2")
  city         VarChar(100)
  region       VarChar(100)?
  postalCode   VarChar(20)?               @map("postal_code")
  createdAt    TimestamptzString          @default(now()) @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")

  customer Customer @relation(
    fields: [customerId],
    references: [id],
    onDelete: Restrict,
    onUpdate: Cascade
  )

  @@index([customerId])
  @@map("service_locations")
}
